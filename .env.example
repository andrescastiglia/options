# readonly se conecta a IOL y sólo avisa/simula; live puede enviar órdenes reales al aprobar Learning.
MODE=readonly
# Acción sobre la que se buscan oportunidades. Por ejemplo, GGAL es Grupo Financiero Galicia.
TICKER=GGAL
# true muestra la pantalla interactiva; false deja el programa funcionando sólo con mensajes de texto.
TUI_ENABLED=true
# Reintentos ante una caída de conexión y espera fija entre cada intento.
CONNECTION_RETRY_ATTEMPTS=3
CONNECTION_RETRY_DELAY_SECS=5
# true retoma la operación anterior después de cerrar o reiniciar el programa.
RECOVER_STATE=true
# Carpeta donde se guarda el estado para poder retomarlo más tarde.
DATA_DIR=data
# Límite agregado, reserva mínima del volumen y retención exclusiva de captures.
# Journal, snapshots, órdenes y evidencia nunca se eliminan automáticamente.
DATA_DIR_MAX_BYTES=2147483648
DATA_DISK_MIN_FREE_BYTES=536870912
MARKET_CAPTURE_RETENTION_DAYS=30
# Guarda cada frame validado de IOL como JSONL para investigación y replay reproducible.
CAPTURE_MARKET_DATA=true
# Calendario de feriados argentinos. Se consulta por año y se guarda bajo DATA_DIR/calendar/.
HOLIDAYS_API_BASE_URL=https://api.argentinadatos.com/v1/feriados
# Manifiesto versionado de sesiones/excepciones BYMA. Es obligatorio para órdenes reales.
# MARKET_SESSIONS_PATH=data/calendar/byma-sessions.json
# La rueda se considera abierta de lunes a viernes, 10:30–17:00 de Argentina,
# excluyendo las fechas entregadas por el calendario de feriados.
# Durante los primeros 45 minutos recopila datos pero no abre posiciones nuevas.
ENTRY_DELAY_AFTER_OPEN_MINS=45
# Evita mantener opciones durante fines de semana o feriados prolongados.
WEEKEND_RISK_ENABLED=true
# En la víspera de una pausa: deja de comprar a las 15:00 y fuerza la venta desde las 16:30.
PRE_BREAK_LAST_ENTRY_TIME=15:00
PRE_BREAK_FORCE_EXIT_TIME=16:30
# Una serie que vence hoy se fuerza a cerrar antes del límite operativo especial.
EXPIRY_DAY_FORCE_EXIT_TIME=15:15
# Entre 12:30 y 14:00 exige mejor liquidez y reduce el tamaño de las entradas.
LUNCH_SLOWDOWN_ENABLED=true
LUNCH_SLOWDOWN_START_TIME=12:30
LUNCH_SLOWDOWN_END_TIME=14:00
LUNCH_POSITION_FACTOR=0.5
LUNCH_MAX_SPREAD_FACTOR=0.75
LUNCH_SIGNAL_THRESHOLD_BONUS=0.05
# Al terminar espera cinco minutos para reconfirmar la tendencia.
POST_LUNCH_CONFIRMATION_MINS=5
# Una serie debe acumular al menos tres cambios de bid, ask o volumen en una ventana completa.
LUNCH_LIQUIDITY_WINDOW_MINS=5
LUNCH_MIN_QUOTE_UPDATES=3
# Para ejecutar sin IOL sobre un dataset, indicar una ruta no vacía; vacío o espacios cuentan como ausente.
# REPLAY_PATH=data/market/GGAL/20689.jsonl
# Cada cuántos segundos se consulta un precio nuevo.
CHECK_INTERVAL_SECS=1
# Cuántos minutos de precios anteriores se usan para decidir si el precio sube o baja.
PRICE_HISTORY_MINUTES=30
# Cuántos precios seguidos hacen falta antes de confiar en una tendencia.
MIN_SAMPLES_FOR_TREND=5
# Cuántos precios en sentido contrario hacen falta para detectar un cambio de tendencia.
TREND_CHANGE_SAMPLES=3
# Separación mínima respecto de la media para considerar una dirección.
TREND_DEADBAND_PERCENTAGE=0.10
MIN_TREND_SLOPE_PERCENT_PER_MINUTE=0.02
MIN_TREND_R_SQUARED=0.60
MIN_TREND_MOVE_VOLATILITY_RATIO=1.0
REVERSAL_COOLDOWN_SECS=300
# Mínimo de días que deben faltar para el vencimiento de la opción elegida.
OPTION_EXPIRY_DAYS=1
OPTION_TARGET_EXPIRY_DAYS=21
OPTION_MAX_EXPIRY_DAYS=45

# Cantidad máxima de contratos que se pueden comprar en una operación.
MAX_POSITION_SIZE=5
# Fallback para paper/legado. Una entrada real exige el multiplicador del instrumento en el catálogo IOL.
CONTRACT_MULTIPLIER=1
# Confirmación manual del fallback para conciliación; no reemplaza metadata real ausente.
CONTRACT_MULTIPLIER_CONFIRMED=false
# Ganancia buscada comparada con el costo de comprar y vender. 2 significa buscar el doble de ese costo.
MIN_PROFIT_MULTIPLIER=2
MIN_REWARD_RISK_RATIO=1.25
# Porcentaje de caída desde el precio de compra que obliga a vender para limitar la pérdida.
STOP_LOSS_PERCENTAGE=15
# Minutos máximos que se mantiene una compra abierta antes de venderla.
POSITION_TIMEOUT_MINS=60
# Dinero máximo que se puede usar en una compra.
MAX_INVESTMENT_AMOUNT=100000
# Pérdida máxima permitida en una sola operación.
MAX_LOSS_PER_TRADE=5000
# Pérdida total máxima permitida en el día; al alcanzarla el programa deja de operar.
MAX_DAILY_LOSS=10000
# Cantidad máxima de operaciones permitidas por día.
MAX_TRADES_PER_DAY=20
# Pequeño empeoramiento de precio usado en la simulación para que el resultado sea más realista. 5 equivale a 0,05%.
READONLY_SLIPPAGE_BPS=5
LEARNING_SLIPPAGE_BPS=25

# VIX opcional. El endpoint debe responder JSON. `value_kind` admite current o previous_close:
# {"level":18.4,"previous_close":17.2,"timestamp_secs":1787662800,"previous_close_timestamp_secs":1787576400,"value_kind":"current"}
# No se recomienda extraer automáticamente sitios web; usar un adaptador propio o un feed licenciado.
# VIX_QUOTE_URL=http://127.0.0.1:8080/vix
# VIX_BEARER_TOKEN=token_del_adaptador
VIX_REFRESH_SECS=60
# Vigencia máxima del dato actual. Un cierre previo nunca se usa como VIX actual.
VIX_MAX_AGE_SECS=900
VIX_PREVIOUS_CLOSE_MAX_AGE_SECS=345600
VIX_ELEVATED_LEVEL=25
VIX_SPIKE_CHANGE_PERCENTAGE=10
# Sólo se aplican si el modelo con VIX supera al modelo base en walk-forward.
VIX_ELEVATED_POSITION_FACTOR=0.5
VIX_SPIKE_THRESHOLD_BONUS=0.10
# Antigüedad máxima, en segundos, que puede tener un precio antes de considerarlo desactualizado.
MAX_MARKET_DATA_AGE_SECS=15
# Diferencia máxima permitida entre el precio de compra y el de venta de una opción.
MAX_OPTION_SPREAD_PERCENTAGE=3
MIN_OPTION_VOLUME=10
# Bloquean nuevas entradas si la cadena válida no alcanza estos mínimos globales.
# Las salidas de posiciones existentes continúan habilitadas.
MIN_OPTION_CHAIN_ACCEPTANCE_PERCENTAGE=80
MIN_OPTION_CHAIN_CONTRACTS_PER_SIDE=1
MAX_OPTION_MONEYNESS_DISTANCE_PERCENTAGE=10

# Investigación cuantitativa. Todos estos cambios están apagados hasta ser validados en replay/readonly.
OPTION_ANALYTICS_ENABLED=false
OPTION_RISK_FREE_RATE=0.35
OPTION_DIVIDEND_YIELD=0
# Timestamp Unix y fuentes del dato tal como eran conocidos al valuar. Es obligatorio
# completar el timestamp cuando OPTION_ANALYTICS_ENABLED=true; evita usar datos futuros.
# OPTION_MARKET_INPUTS_OBSERVED_AT_SECS=1787662800
OPTION_MARKET_INPUTS_MAX_AGE_SECS=86400
OPTION_RISK_FREE_SOURCE=manual_env
OPTION_DIVIDEND_SOURCE=manual_env
OPTION_BINOMIAL_STEPS=150
OPTION_MIN_ABS_DELTA=0.15
OPTION_MAX_ABS_DELTA=0.85
OPTION_MIN_IMPLIED_VOLATILITY=0.01
OPTION_MAX_IMPLIED_VOLATILITY=3
OPTION_MAX_EXTRINSIC_PERCENTAGE=100
IV_RANK_FILTER_ENABLED=false
IV_RANK_WINDOW_SESSIONS=252
IV_RANK_MIN_SESSIONS=60
IV_RANK_MIN=0
IV_RANK_MAX=100
ADAPTIVE_ENTRY_FILTER_ENABLED=false
MAX_FRICTION_STOP_RATIO=0.25
VOLATILITY_NORMALIZED_SIGNALS_ENABLED=false
TARGET_UNDERLYING_VOLATILITY_PERCENTAGE=1
NONLINEAR_META_FILTER_ENABLED=false
TREE_META_FILTER_ENABLED=false
TREE_META_FILTER_MIN_IMPROVEMENT=0.05
EXPERIMENT_RUNNER_ENABLED=false
VERTICAL_SPREAD_RESEARCH_ENABLED=false
VERTICAL_ATOMIC_EXECUTION_VERIFIED=false

# Gate automático de Learning a Eligible, previo a Armed/Canary/Live.
LIVE_LEARNING_MIN_TRADES=200
LIVE_LEARNING_MIN_CALL_TRADES=75
LIVE_LEARNING_MIN_PUT_TRADES=75
LIVE_LEARNING_MIN_SESSIONS=20
LIVE_LEARNING_MIN_PROFIT_FACTOR=1.25
META_FILTER_MIN_EXAMPLES=100
META_FILTER_MIN_TRAIN_EXAMPLES=60
META_FILTER_MIN_ACCEPTED_HOLDOUT=20
META_FILTER_MIN_COVERAGE=0.15
META_FILTER_MAX_BRIER_SCORE=0.25
META_FILTER_MIN_POSITIVE_FOLD_RATIO=0.67
META_FILTER_MAX_CONCENTRATION=0.85
LIVE_REGRESSION_WINDOW_TRADES=30
LIVE_MAX_CONSECUTIVE_LOSSES=3

# Gate canary: exposición real reducida antes de habilitar los límites Live completos.
CANARY_MIN_TRADES=20
CANARY_MIN_CALL_TRADES=5
CANARY_MIN_PUT_TRADES=5
CANARY_MIN_SESSIONS=5
CANARY_MAX_POSITION_SIZE=1
CANARY_MAX_INVESTMENT_AMOUNT=10000
CANARY_MAX_LOSS_PER_TRADE=500
CANARY_MAX_DAILY_LOSS=1000
CANARY_MAX_TRADES_PER_DAY=5

# Porcentaje de comisión cobrado por IOL. El programa intenta ajustarlo usando la última operación terminada.
COMMISSION_PERCENTAGE=0.19
# Porcentaje de IVA que se aplica sobre las comisiones y otros cargos.
VAT_PERCENTAGE=21
# Otros cargos porcentuales de la operación, además de la comisión.
OTHER_FEES_PERCENTAGE=0
# Porcentaje estimado de impuestos sobre una ganancia. Conviene confirmarlo con un contador.
TAX_PERCENTAGE=35

# Dirección principal de IOL. No cambiar salvo que IOL indique una nueva.
IOL_BASE_URL=https://api.invertironline.com
# Referencia horaria independiente de IOL. Es obligatoria en live, debe usar
# otro origen HTTPS y responder un encabezado HTTP Date confiable.
# TIME_REFERENCE_URL=https://clock.example.invalid/time
TIME_REFERENCE_REFRESH_SECS=300
TIME_REFERENCE_MAX_SKEW_SECS=30
# WebSocket opcional: REST sigue siendo autoritativo para órdenes y datos de mercado.
IOL_WEBSOCKET_ENABLED=false
# Dirección usada sólo cuando IOL_WEBSOCKET_ENABLED=true. Debe usar WSS.
IOL_WEBSOCKET_URL=wss://websocket-movements.invertironline.com/
# Readiness pre-canary v2 firmado, ligado al build y a reportes de cobertura/mutación.
# LIVE_READINESS_PATH=data/live/release-readiness.json
# Archivo efímero generado con `cargo run -- --authorize-live REQUEST OUTPUT`.
# LIVE_AUTHORIZATION_PATH=data/live/live-authorization.json
# Correo o nombre de usuario con el que se ingresa a IOL. Es necesario en readonly y live.
IOL_USERNAME=nombre@mail.com
# Ruta absoluta a la clave privada creada con `cargo run -- --init-master-key RUTA`.
# Guardarla fuera de DATA_DIR y del repositorio; en Unix debe tener permisos 0600.
# OPTIONS_MASTER_KEY_PATH=/ruta/privada/options-master.key
# Contraseña cifrada. Con OPTIONS_MASTER_KEY_PATH configurada, ejecutar
# `cargo run -- --encrypt-password` y pegar aquí el valor v3: que muestra.
IOL_PASSWORD=pegar_aqui_el_resultado_v3
# Clave temporal entregada por IOL para mantener la sesión. Puede dejarse vacía si no se dispone de una.
# IOL_REFRESH_TOKEN=
# Cantidad máxima de consultas a IOL que pueden estar en curso al mismo tiempo.
MAX_CONCURRENT_REQUESTS=10
# Segundos durante los que se reutiliza la lista de opciones antes de volver a pedirla a IOL.
CACHE_TTL_SECS=60

# Único endpoint de alta de órdenes permitido por el contrato IOL auditado.
# IOL_ORDER_PATH=/api/v2/operar
# Segundos máximos para esperar que una orden aceptada llegue a estado terminal antes de cancelarla.
ORDER_TRACKING_TIMEOUT_SECS=30
# Intervalo de consulta REST durante el seguimiento. El WebSocket sólo puede adelantar una consulta si identifica la orden.
ORDER_STATUS_POLL_INTERVAL_MILLIS=1000
# Segundos máximos para confirmar el estado terminal después de solicitar la cancelación.
ORDER_CANCEL_TIMEOUT_SECS=15
# Identifica el estudio frame-aware; la ruta operativa sigue usando límite fijo y nunca persigue precio real.
DYNAMIC_LIMIT_ENABLED=false
DYNAMIC_LIMIT_STEPS=4
DYNAMIC_LIMIT_FRAME_WAIT_SECS=2
DYNAMIC_LIMIT_QUEUE_AHEAD_FACTOR=1
DYNAMIC_LIMIT_ADVERSE_SELECTION_BPS=10
# Frase de seguridad obligatoria para habilitar dinero real. Dejar comentada para impedir órdenes reales.
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_THIS_SENDS_REAL_ORDERS

# Cantidad de detalle de los mensajes: debug (mucho), info (normal), warn (sólo avisos) o error (sólo errores).
LOG_LEVEL=info
