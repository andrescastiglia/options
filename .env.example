# Modo seguro por defecto: replay | paper | live
MODE=replay
TICKER=GAL
TUI_ENABLED=true
RECOVER_STATE=false
DATA_DIR=data

# Mercado y señal
CHECK_INTERVAL_SECS=1
PRICE_HISTORY_MINUTES=30
MIN_SAMPLES_FOR_TREND=5
TREND_CHANGE_SAMPLES=3
OPTION_EXPIRY_DAYS=1

# Economía y riesgo
MAX_POSITION_SIZE=5
CONTRACT_MULTIPLIER=1
COMMISSION_PERCENTAGE=0.19
TAX_PERCENTAGE=35
MIN_PROFIT_MULTIPLIER=2
STOP_LOSS_PERCENTAGE=15
MAX_INVESTMENT_AMOUNT=100000
MAX_LOSS_PER_TRADE=5000
MAX_DAILY_LOSS=10000
MAX_TRADES_PER_DAY=20
PAPER_SLIPPAGE_BPS=5
MAX_MARKET_DATA_AGE_SECS=15
MAX_OPTION_SPREAD_PERCENTAGE=20

# Integración IOL (requerida para paper/live)
IOL_BASE_URL=https://api.invertironline.com
IOL_USERNAME=
IOL_PASSWORD=
IOL_REFRESH_TOKEN=
MAX_CONCURRENT_REQUESTS=10
CACHE_TTL_SECS=60

# Live: no completar hasta verificar el contrato de órdenes
# IOL_ORDER_PATH=/ruta/verificada
# LIVE_TRADING_CONFIRMATION=I_UNDERSTAND_THIS_SENDS_REAL_ORDERS

LOG_LEVEL=info
